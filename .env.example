# ===================================================
# Sentinel Enterprise AI Fabric - Configuration Reference
# ===================================================

# Server Environment
ENV=development
DEBUG=false
APP_NAME="Sentinel Enterprise AI Fabric"
APP_VERSION=1.0.0
HOST=0.0.0.0
PORT=8000

# Persistence & Storage
DATA_DIR=./data
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION_PREFIX=sentinel
AUDIT_LOG_PATH=./data/audit/audit_events.jsonl

# Ingestion Limits
MAX_UPLOAD_SIZE_BYTES=26214400 # 25 MB
DEFAULT_CHUNK_SIZE=512
DEFAULT_CHUNK_OVERLAP=64
MAX_BATCH_CONCURRENCY=4

# Embeddings & Vector Search
EMBEDDING_PROVIDER=mock # Options: mock, ollama
EMBEDDING_MODEL_NAME=sentinel-embed-v1
EMBEDDING_DIMENSION=384

# Reranking & Retrieval Thresholds
RERANKER_PROVIDER=mock
RETRIEVAL_TOP_K=5
RERANK_TOP_K=3
GROUNDING_SCORE_THRESHOLD=0.45

# Generation & LLM Settings
LLM_PROVIDER=mock # Options: mock, ollama
LLM_MODEL_NAME=llama3:8b
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_SECONDS=30.0

# Governance & Security Approvals
AGENT_APPROVAL_SECRET=replace-with-a-secure-random-hmac-key-for-production
AGENT_APPROVAL_TTL_SECONDS=900 # 15 minutes
RATE_LIMIT_PER_MINUTE=120

# Logging & Telemetry
LOG_LEVEL=INFO
LOG_JSON_FORMAT=true
